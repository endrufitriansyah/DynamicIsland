<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Raw Color Definitions -->
    <Color x:Key="ColorPrimaryBackground">#09090B</Color>
    <Color x:Key="ColorSecondaryBackground">#111113</Color>
    <Color x:Key="ColorSurface">#18181B</Color>
    <Color x:Key="ColorElevatedSurface">#222226</Color>
    <Color x:Key="ColorBorder">#303036</Color>
    <Color x:Key="ColorPrimaryText">#FAFAFA</Color>
    <Color x:Key="ColorSecondaryText">#A1A1AA</Color>
    <Color x:Key="ColorMutedText">#71717A</Color>
    <Color x:Key="ColorAccent">#8B9CF7</Color>
    <Color x:Key="ColorAccentHover">#9FAFF9</Color>
    <Color x:Key="ColorSuccess">#34D399</Color>
    <Color x:Key="ColorWarning">#FBBF24</Color>
    <Color x:Key="ColorDanger">#F87171</Color>

    <!-- SolidColorBrushes -->
    <SolidColorBrush x:Key="BrushPrimaryBackground" Color="{StaticResource ColorPrimaryBackground}" />
    <SolidColorBrush x:Key="BrushSecondaryBackground" Color="{StaticResource ColorSecondaryBackground}" />
    <SolidColorBrush x:Key="BrushSurface" Color="{StaticResource ColorSurface}" />
    <SolidColorBrush x:Key="BrushElevatedSurface" Color="{StaticResource ColorElevatedSurface}" />
    <SolidColorBrush x:Key="BrushBorder" Color="{StaticResource ColorBorder}" />
    <SolidColorBrush x:Key="BrushPrimaryText" Color="{StaticResource ColorPrimaryText}" />
    <SolidColorBrush x:Key="BrushSecondaryText" Color="{StaticResource ColorSecondaryText}" />
    <SolidColorBrush x:Key="BrushMutedText" Color="{StaticResource ColorMutedText}" />
    <SolidColorBrush x:Key="BrushAccent" Color="{StaticResource ColorAccent}" />
    <SolidColorBrush x:Key="BrushAccentHover" Color="{StaticResource ColorAccentHover}" />
    <SolidColorBrush x:Key="BrushSuccess" Color="{StaticResource ColorSuccess}" />
    <SolidColorBrush x:Key="BrushWarning" Color="{StaticResource ColorWarning}" />
    <SolidColorBrush x:Key="BrushDanger" Color="{StaticResource ColorDanger}" />

</ResourceDictionary>
