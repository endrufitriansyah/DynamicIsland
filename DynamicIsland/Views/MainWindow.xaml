<Window x:Class="DynamicIsland.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:DynamicIsland.ViewModels"
        xmlns:controls="clr-namespace:DynamicIsland.Controls"
        mc:Ignorable="d"
        Title="Dynamic Island untuk Windows — Sistem Desain &amp; Ikon"
        Height="720" Width="840"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BrushPrimaryBackground}"
        Foreground="{StaticResource BrushPrimaryText}">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Background="{StaticResource BrushSecondaryBackground}"
                BorderBrush="{StaticResource BrushBorder}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16"
                Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <controls:LucideIcon Kind="Settings" Size="20" Foreground="{StaticResource BrushAccent}" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding Title}"
                                   Style="{StaticResource TextHeader}"
                                   FontSize="16"/>
                    </StackPanel>
                    <TextBlock Text="{Binding Status}"
                               Style="{StaticResource TextSubheader}"
                               Margin="0,4,0,0"/>
                    <TextBlock Text="{Binding SubStatus}"
                               Style="{StaticResource TextMuted}"
                               Margin="0,2,0,0"/>
                </StackPanel>

                <Border Grid.Column="1"
                        Style="{StaticResource StatusBadge}"
                        VerticalAlignment="Center">
                    <TextBlock Text=".NET 10 LTS"
                               Style="{StaticResource TextCaption}"
                               Foreground="{StaticResource BrushSuccess}"/>
                </Border>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                
                <!-- Section 1: Pratinjau Bentuk Dynamic Island (Compact & Expanded) -->
                <TextBlock Text="Pratinjau Geometri Dynamic Island"
                           Style="{StaticResource TextHeader}"
                           Margin="0,0,0,12"/>

                <Grid Margin="0,0,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Compact Pill Preview -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Status Ringkas (Compact Pill)"
                                   Style="{StaticResource TextCaption}"
                                   Margin="0,0,0,6"/>
                        <Border Background="{StaticResource BrushPrimaryBackground}"
                                BorderBrush="{StaticResource BrushBorder}"
                                BorderThickness="1"
                                CornerRadius="16"
                                Height="34"
                                Width="220"
                                Padding="12,0">
                            <Grid VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <controls:LucideIcon Kind="Music" Size="14" Foreground="{StaticResource BrushAccent}"/>
                                    <TextBlock Text="Spotify"
                                               Style="{StaticResource TextCaption}"
                                               Foreground="{StaticResource BrushSecondaryText}"
                                               Margin="6,0,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <controls:LucideIcon Kind="BatteryCharging" Size="14" Foreground="{StaticResource BrushSuccess}"/>
                                    <TextBlock Text="92%"
                                               Style="{StaticResource TextCaption}"
                                               Foreground="{StaticResource BrushSuccess}"
                                               Margin="4,0,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- Expanded Card Preview -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Status Ekspansi (Expanded Card)"
                                   Style="{StaticResource TextCaption}"
                                   Margin="0,0,0,6"/>
                        <Border Background="{StaticResource BrushSurface}"
                                BorderBrush="{StaticResource BrushBorder}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Baris Atas: Info Media & Badge -->
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Mock Album Art Solid Flat -->
                                    <Border Grid.Column="0"
                                            Width="40" Height="40"
                                            Background="{StaticResource BrushElevatedSurface}"
                                            BorderBrush="{StaticResource BrushBorder}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Margin="0,0,12,0">
                                        <controls:LucideIcon Kind="Music" Size="18" Foreground="{StaticResource BrushAccent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Midnight City"
                                                   Style="{StaticResource TextHeader}"/>
                                        <TextBlock Text="M83 • Hurry Up, We're Dreaming"
                                                   Style="{StaticResource TextMuted}"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <Border Grid.Column="2"
                                            Style="{StaticResource StatusBadge}"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="GSMTC AKTIF"
                                                   Style="{StaticResource TextCaption}"
                                                   Foreground="{StaticResource BrushAccent}"/>
                                    </Border>
                                </Grid>

                                <!-- Baris Tengah: Progress Bar -->
                                <Grid Grid.Row="1" Margin="0,12,0,8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <ProgressBar Grid.Row="0"
                                                 Style="{StaticResource FlatProgressBar}"
                                                 Value="42"
                                                 Maximum="100"/>
                                    <Grid Grid.Row="1" Margin="0,4,0,0">
                                        <TextBlock Text="1:42" Style="{StaticResource TextCaption}" HorizontalAlignment="Left"/>
                                        <TextBlock Text="4:03" Style="{StaticResource TextCaption}" HorizontalAlignment="Right"/>
                                    </Grid>
                                </Grid>

                                <!-- Baris Bawah: Kontrol Playback Sederhana -->
                                <StackPanel Grid.Row="2"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Center">
                                    <Button Style="{StaticResource IconButton}">
                                        <controls:LucideIcon Kind="SkipBack" Size="16"/>
                                    </Button>
                                    <Button Style="{StaticResource IconButton}" Margin="8,0">
                                        <controls:LucideIcon Kind="Play" Size="16" Foreground="{StaticResource BrushAccent}"/>
                                    </Button>
                                    <Button Style="{StaticResource IconButton}">
                                        <controls:LucideIcon Kind="SkipForward" Size="16"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Section 2: Galeri Ikon Vektor Lucide -->
                <TextBlock Text="Pustaka Ikon Vektor Lucide (Sharp at Any DPI)"
                           Style="{StaticResource TextHeader}"
                           Margin="0,0,0,12"/>

                <Border Style="{StaticResource FlatCard}" Padding="16" Margin="0,0,0,24">
                    <ItemsControl ItemsSource="{Binding Icons}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel ItemWidth="118" ItemHeight="64"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource BrushElevatedSurface}"
                                        BorderBrush="{StaticResource BrushBorder}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Margin="4"
                                        Padding="8,6">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <controls:LucideIcon Grid.Row="0"
                                                             Kind="{Binding Kind}"
                                                             Size="18"
                                                             Foreground="{StaticResource BrushPrimaryText}"
                                                             HorizontalAlignment="Center"
                                                             VerticalAlignment="Center"/>
                                        <TextBlock Grid.Row="1"
                                                   Text="{Binding Name}"
                                                   Style="{StaticResource TextCaption}"
                                                   HorizontalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,2,0,0"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <!-- Section 3: Palet Warna Solid Flat Minimalis -->
                <TextBlock Text="Palet Warna Solid Desain (Tanpa Gradien)"
                           Style="{StaticResource TextHeader}"
                           Margin="0,0,0,12"/>

                <WrapPanel Margin="0,0,0,16">
                    <!-- Accent -->
                    <Border Background="{StaticResource BrushAccent}" Width="90" Height="48" CornerRadius="6" Margin="0,0,8,8" Padding="6">
                        <TextBlock Text="Accent&#x0a;#8B9CF7" Style="{StaticResource TextCaption}" Foreground="#09090B" FontWeight="Bold"/>
                    </Border>
                    <!-- Success -->
                    <Border Background="{StaticResource BrushSuccess}" Width="90" Height="48" CornerRadius="6" Margin="0,0,8,8" Padding="6">
                        <TextBlock Text="Success&#x0a;#34D399" Style="{StaticResource TextCaption}" Foreground="#09090B" FontWeight="Bold"/>
                    </Border>
                    <!-- Warning -->
                    <Border Background="{StaticResource BrushWarning}" Width="90" Height="48" CornerRadius="6" Margin="0,0,8,8" Padding="6">
                        <TextBlock Text="Warning&#x0a;#FBBF24" Style="{StaticResource TextCaption}" Foreground="#09090B" FontWeight="Bold"/>
                    </Border>
                    <!-- Danger -->
                    <Border Background="{StaticResource BrushDanger}" Width="90" Height="48" CornerRadius="6" Margin="0,0,8,8" Padding="6">
                        <TextBlock Text="Danger&#x0a;#F87171" Style="{StaticResource TextCaption}" Foreground="#FAFAFA" FontWeight="Bold"/>
                    </Border>
                    <!-- Surface -->
                    <Border Background="{StaticResource BrushSurface}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" Width="90" Height="48" CornerRadius="6" Margin="0,0,8,8" Padding="6">
                        <TextBlock Text="Surface&#x0a;#18181B" Style="{StaticResource TextCaption}" Foreground="{StaticResource BrushPrimaryText}"/>
                    </Border>
                    <!-- Elevated Surface -->
                    <Border Background="{StaticResource BrushElevatedSurface}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" Width="90" Height="48" CornerRadius="6" Margin="0,0,8,8" Padding="6">
                        <TextBlock Text="Elevated&#x0a;#222226" Style="{StaticResource TextCaption}" Foreground="{StaticResource BrushPrimaryText}"/>
                    </Border>
                </WrapPanel>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2"
                BorderBrush="{StaticResource BrushBorder}"
                BorderThickness="0,1,0,0"
                Padding="0,16,0,0">
            <Grid>
                <TextBlock Text="Dynamic Island Windows 11 — Phase 2 Siap"
                           Style="{StaticResource TextCaption}"
                           VerticalAlignment="Center"/>
                <Button Content="Tutup Aplikasi"
                        HorizontalAlignment="Right"
                        Style="{StaticResource FlatButton}"
                        Click="ExitButton_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
