<Window x:Class="DynamicIsland.Views.Island.IslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:DynamicIsland.ViewModels"
        xmlns:controls="clr-namespace:DynamicIsland.Controls"
        mc:Ignorable="d"
        Title="Dynamic Island"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="{x:Null}"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="Manual"
        Width="500"
        Height="290">

    <Window.DataContext>
        <vm:IslandViewModel x:Name="ViewModel"/>
    </Window.DataContext>

    <!-- Context Menu untuk Island -->
    <Window.ContextMenu>
        <ContextMenu Background="{StaticResource BrushSurface}"
                     BorderBrush="{StaticResource BrushBorder}"
                     BorderThickness="1"
                     Foreground="{StaticResource BrushPrimaryText}">
            <MenuItem Header="Alihkan Tampilan (Ekspansi / Ciut)" Click="MenuToggle_Click"/>
            <Separator Background="{StaticResource BrushBorder}"/>
            <MenuItem Header="Mode: Pemutar Musik" Click="MenuMediaMode_Click"/>
            <MenuItem Header="Mode: Pemantau Sistem" Click="MenuSystemMode_Click"/>
            <MenuItem Header="Mode: Timer &amp; Pomodoro" Click="MenuTimerMode_Click"/>
            <MenuItem Header="Mode: Riwayat Papan Klip" Click="MenuClipboardMode_Click"/>
            <MenuItem Header="Mode: Peluncur Cepat" Click="MenuLauncherMode_Click"/>
            <Separator Background="{StaticResource BrushBorder}"/>
            <MenuItem Header="Pengaturan Aplikasi..." Click="MenuSettings_Click"/>
            <MenuItem Header="Reset Posisi (Tengah Atas)" Click="MenuResetPosition_Click"/>
            <Separator Background="{StaticResource BrushBorder}"/>
            <MenuItem Header="Keluar dari Aplikasi" Click="MenuExit_Click"/>
        </ContextMenu>
    </Window.ContextMenu>

    <!-- Root Grid yang transparan untuk penempatan island -->
    <Grid HorizontalAlignment="Center" VerticalAlignment="Top">

        <!-- Kontainer Fisik Island -->
        <Border x:Name="IslandContainer"
                Background="{StaticResource BrushPrimaryBackground}"
                BorderBrush="{StaticResource BrushBorder}"
                BorderThickness="1"
                CornerRadius="17"
                Width="210"
                Height="34"
                SnapsToDevicePixels="True"
                Cursor="Hand"
                PreviewMouseLeftButtonDown="IslandContainer_PreviewMouseLeftButtonDown"
                PreviewMouseMove="IslandContainer_PreviewMouseMove"
                PreviewMouseLeftButtonUp="IslandContainer_PreviewMouseLeftButtonUp"
                MouseEnter="IslandContainer_MouseEnter"
                MouseLeave="IslandContainer_MouseLeave">

            <Grid ClipToBounds="True">

                <!-- 1. TAMPILAN COMPACT (PILL RINGKAS) -->
                <Grid x:Name="CompactContent"
                      IsHitTestVisible="False"
                      Opacity="1.0"
                      Margin="12,0"
                      VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Sisi Kiri Compact: Ikon Netral / Media & Status -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <controls:LucideIcon Kind="{Binding CompactIconKind}" Size="13" Foreground="{StaticResource BrushAccent}"/>
                        <TextBlock Text="{Binding CompactLeftText}"
                                   Style="{StaticResource TextCaption}"
                                   Foreground="{StaticResource BrushSecondaryText}"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="120"
                                   Margin="6,0,0,0"/>
                    </StackPanel>

                    <!-- Indikator Sentral (Titik Halus) -->
                    <Ellipse Grid.Column="1"
                             Width="3" Height="3"
                             Fill="{StaticResource BrushBorder}"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"/>

                    <!-- Sisi Kanan Compact: Jam Digital (Status Baterai Hanya di Tab Sistem) -->
                    <TextBlock Grid.Column="2"
                               Text="{Binding CompactRightText}"
                               Style="{StaticResource TextCaption}"
                               Foreground="{StaticResource BrushMutedText}"
                               VerticalAlignment="Center"/>
                </Grid>

                <!-- 2. TAMPILAN EXPANDED (KARTU MODULAR EKSPANSI) -->
                <Grid x:Name="ExpandedContent"
                      Opacity="0.0"
                      Visibility="Collapsed"
                      Margin="14,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Header / Mode Switcher -->
                        <RowDefinition Height="*"/>    <!-- Konten Mode Aktif -->
                    </Grid.RowDefinitions>

                    <!-- Baris Atas: Tab Mode & Tombol Tutup/Ciutkan -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Pilihan Tab Mode Produktivitas -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <Button Style="{StaticResource FlatButton}" Padding="7,3" Margin="0,0,3,0" Click="TabMedia_Click"
                                    Visibility="{Binding EnableMediaModule, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel Orientation="Horizontal">
                                    <controls:LucideIcon Kind="Music" Size="12" Foreground="{StaticResource BrushAccent}" Margin="0,0,4,0"/>
                                    <TextBlock Text="Musik" Style="{StaticResource TextCaption}"/>
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource FlatButton}" Padding="7,3" Margin="0,0,3,0" Click="TabSystem_Click"
                                    Visibility="{Binding EnableSystemModule, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel Orientation="Horizontal">
                                    <controls:LucideIcon Kind="Cpu" Size="12" Foreground="{StaticResource BrushSuccess}" Margin="0,0,4,0"/>
                                    <TextBlock Text="Sistem" Style="{StaticResource TextCaption}"/>
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource FlatButton}" Padding="7,3" Margin="0,0,3,0" Click="TabTimer_Click"
                                    Visibility="{Binding EnableTimerModule, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel Orientation="Horizontal">
                                    <controls:LucideIcon Kind="Timer" Size="12" Foreground="{StaticResource BrushWarning}" Margin="0,0,4,0"/>
                                    <TextBlock Text="Waktu" Style="{StaticResource TextCaption}"/>
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource FlatButton}" Padding="7,3" Margin="0,0,3,0" Click="TabClipboard_Click"
                                    Visibility="{Binding EnableClipboardModule, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel Orientation="Horizontal">
                                    <controls:LucideIcon Kind="Clipboard" Size="12" Foreground="{StaticResource BrushAccent}" Margin="0,0,4,0"/>
                                    <TextBlock Text="Klip" Style="{StaticResource TextCaption}"/>
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource FlatButton}" Padding="7,3" Click="TabLauncher_Click"
                                    Visibility="{Binding EnableLauncherModule, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel Orientation="Horizontal">
                                    <controls:LucideIcon Kind="Launcher" Size="12" Foreground="{StaticResource BrushPrimaryText}" Margin="0,0,4,0"/>
                                    <TextBlock Text="Peluncur" Style="{StaticResource TextCaption}"/>
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource FlatButton}" Padding="7,3" Margin="3,0,0,0" Click="TabNotif_Click"
                                    Visibility="{Binding EnableNotifModule, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel Orientation="Horizontal">
                                    <controls:LucideIcon Kind="Bell" Size="12" Foreground="{StaticResource BrushDanger}" Margin="0,0,4,0"/>
                                    <TextBlock Text="Notif" Style="{StaticResource TextCaption}"/>
                                    <Ellipse Width="6" Height="6" Fill="{StaticResource BrushDanger}" Margin="4,0,0,0" VerticalAlignment="Center">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasNewNotification}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- Tombol Ciutkan -->
                        <Button Grid.Column="1"
                                Style="{StaticResource IconButton}"
                                Width="26" Height="26"
                                Click="BtnCollapse_Click"
                                ToolTip="Ciutkan ke Pill">
                            <controls:LucideIcon Kind="ChevronUp" Size="14"/>
                        </Button>
                    </Grid>

                    <!-- Baris Tengah: Panel Konten Berdasarkan Mode -->
                    <Grid Grid.Row="1">

                        <!-- 1. Mode Musik (GSMTC Real-Time) -->
                        <Grid x:Name="PanelMedia" Visibility="Visible">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Info Trek & Album Artwork -->
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Album Artwork atau Fallback Netral -->
                                <Grid Grid.Column="0" Width="40" Height="40" Margin="0,0,10,0">
                                    <Border Background="{StaticResource BrushElevatedSurface}"
                                            BorderBrush="{StaticResource BrushBorder}"
                                            BorderThickness="1"
                                            CornerRadius="6">
                                        <controls:LucideIcon Kind="{Binding CompactIconKind}" Size="18" Foreground="{StaticResource BrushAccent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <Border CornerRadius="6" ClipToBounds="True">
                                        <Image Source="{Binding AlbumArtwork}" Stretch="UniformToFill">
                                            <Image.Style>
                                                <Style TargetType="Image">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <Trigger Property="Source" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Image.Style>
                                        </Image>
                                    </Border>
                                </Grid>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding MediaTitle}"
                                               Style="{StaticResource TextHeader}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding MediaArtist}"
                                               Style="{StaticResource TextMuted}"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,2,0,0"/>
                                </StackPanel>

                                <Border Grid.Column="2" Style="{StaticResource StatusBadge}" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding MediaAppDisplayName}" Style="{StaticResource TextCaption}" Foreground="{StaticResource BrushAccent}"/>
                                </Border>
                            </Grid>

                            <!-- Progress Bar Waktu Berjalan -->
                            <Grid Grid.Row="1" Margin="0,10,0,6">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <ProgressBar Grid.Row="0"
                                             Style="{StaticResource FlatProgressBar}"
                                             Value="{Binding MediaProgress}"
                                             Maximum="100"/>
                                <Grid Grid.Row="1" Margin="0,3,0,0">
                                    <TextBlock Text="{Binding MediaCurrentTime}" Style="{StaticResource TextCaption}" HorizontalAlignment="Left"/>
                                    <TextBlock Text="{Binding MediaTotalTime}" Style="{StaticResource TextCaption}" HorizontalAlignment="Right"/>
                                </Grid>
                            </Grid>

                            <!-- Kontrol Media -->
                            <StackPanel Grid.Row="2"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        Margin="0,2,0,0">
                                <Button Style="{StaticResource IconButton}" Command="{Binding SkipPreviousCommand}">
                                    <controls:LucideIcon Kind="SkipBack" Size="15"/>
                                </Button>
                                <Button Style="{StaticResource IconButton}" Margin="14,0" Command="{Binding TogglePlayPauseCommand}">
                                    <Grid>
                                        <controls:LucideIcon Kind="Play" Size="15" Foreground="{StaticResource BrushAccent}">
                                            <controls:LucideIcon.Style>
                                                <Style TargetType="controls:LucideIcon">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPlaying}" Value="False">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </controls:LucideIcon.Style>
                                        </controls:LucideIcon>
                                        <controls:LucideIcon Kind="Pause" Size="15" Foreground="{StaticResource BrushAccent}">
                                            <controls:LucideIcon.Style>
                                                <Style TargetType="controls:LucideIcon">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </controls:LucideIcon.Style>
                                        </controls:LucideIcon>
                                    </Grid>
                                </Button>
                                <Button Style="{StaticResource IconButton}" Command="{Binding SkipNextCommand}">
                                    <controls:LucideIcon Kind="SkipForward" Size="15"/>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- 2. Mode Pemantau Sistem (CPU, RAM, Baterai Eksklusif, Jaringan) -->
                        <Grid x:Name="PanelSystem" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <UniformGrid Grid.Row="0" Columns="3" Margin="0,2,0,6">
                                <Border Style="{StaticResource FlatCard}" Margin="0,0,4,0" Padding="8,6">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <controls:LucideIcon Kind="Cpu" Size="12" Foreground="{StaticResource BrushSuccess}" Margin="0,0,4,0"/>
                                            <TextBlock Text="CPU" Style="{StaticResource TextCaption}"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding CpuUsageText}" Style="{StaticResource TextHeader}" Margin="0,2,0,4"/>
                                        <ProgressBar Style="{StaticResource FlatProgressBar}" Value="{Binding CpuUsageValue}" Maximum="100"/>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource FlatCard}" Margin="2,0,2,0" Padding="8,6">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <controls:LucideIcon Kind="Launcher" Size="12" Foreground="{StaticResource BrushAccent}" Margin="0,0,4,0"/>
                                            <TextBlock Text="RAM" Style="{StaticResource TextCaption}"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding RamUsageText}" Style="{StaticResource TextCaption}" FontWeight="SemiBold" Foreground="{StaticResource BrushPrimaryText}" Margin="0,2,0,4"/>
                                        <ProgressBar Style="{StaticResource FlatProgressBar}" Foreground="{StaticResource BrushAccent}" Value="{Binding RamUsageValue}" Maximum="100"/>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource FlatCard}" Margin="4,0,0,0" Padding="8,6">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <controls:LucideIcon Kind="BatteryCharging" Size="12" Foreground="{StaticResource BrushWarning}" Margin="0,0,4,0"/>
                                            <TextBlock Text="Daya" Style="{StaticResource TextCaption}"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding BatteryStatusText}" Style="{StaticResource TextCaption}" FontWeight="SemiBold" Foreground="{StaticResource BrushPrimaryText}" TextTrimming="CharacterEllipsis" Margin="0,2,0,4"/>
                                        <ProgressBar Style="{StaticResource FlatProgressBar}" Foreground="{StaticResource BrushWarning}" Value="{Binding BatteryPercent}" Maximum="100"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <Border Grid.Row="1" Style="{StaticResource FlatCard}" Padding="10,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <controls:LucideIcon Kind="Wifi" Size="13" Foreground="{StaticResource BrushAccent}" Margin="0,0,6,0"/>
                                        <TextBlock Text="Jaringan Lokal" Style="{StaticResource TextCaption}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="↓ " Style="{StaticResource TextCaption}" Foreground="{StaticResource BrushSuccess}"/>
                                        <TextBlock Text="{Binding NetworkDownloadText}" Style="{StaticResource TextCaption}" Foreground="{StaticResource BrushPrimaryText}" Margin="0,0,10,0"/>
                                        <TextBlock Text="↑ " Style="{StaticResource TextCaption}" Foreground="{StaticResource BrushAccent}"/>
                                        <TextBlock Text="{Binding NetworkUploadText}" Style="{StaticResource TextCaption}" Foreground="{StaticResource BrushPrimaryText}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- 3. Mode Timer & Pomodoro (Phase 5) -->
                        <Grid x:Name="PanelTimer" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Pomodoro Card -->
                            <Border Grid.Column="0" Style="{StaticResource FlatCard}" Padding="10,8">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" Orientation="Horizontal">
                                        <controls:LucideIcon Kind="Timer" Size="12" Foreground="{StaticResource BrushAccent}" Margin="0,0,4,0"/>
                                        <TextBlock Text="{Binding PomodoroSessionLabel}" Style="{StaticResource TextCaption}" Foreground="{StaticResource BrushSecondaryText}"/>
                                    </StackPanel>

                                    <TextBlock Grid.Row="1" Text="{Binding PomodoroTimeText}" Style="{StaticResource TextHeader}" FontSize="20" HorizontalAlignment="Center" Margin="0,4,0,2"/>

                                    <ProgressBar Grid.Row="2" Style="{StaticResource FlatProgressBar}" Value="{Binding PomodoroProgress}" Maximum="100" Margin="0,0,0,6"/>

                                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Style="{StaticResource FlatButton}" Padding="8,2" Command="{Binding TogglePomodoroCommand}">
                                            <TextBlock>
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource TextCaption}">
                                                        <Setter Property="Text" Value="Mulai"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsPomodoroRunning}" Value="True">
                                                                <Setter Property="Text" Value="Jeda"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Button>
                                        <Button Style="{StaticResource FlatButton}" Padding="8,2" Margin="6,0,0,0" Content="Reset" Command="{Binding ResetPomodoroCommand}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Stopwatch Card -->
                            <Border Grid.Column="2" Style="{StaticResource FlatCard}" Padding="10,8">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" Orientation="Horizontal">
                                        <controls:LucideIcon Kind="Refresh" Size="12" Foreground="{StaticResource BrushSuccess}" Margin="0,0,4,0"/>
                                        <TextBlock Text="Stopwatch" Style="{StaticResource TextCaption}" Foreground="{StaticResource BrushSecondaryText}"/>
                                    </StackPanel>

                                    <TextBlock Grid.Row="1" Text="{Binding StopwatchTimeText}" Style="{StaticResource TextHeader}" FontSize="20" HorizontalAlignment="Center" Margin="0,10,0,12"/>

                                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Style="{StaticResource FlatButton}" Padding="8,2" Command="{Binding ToggleStopwatchCommand}">
                                            <TextBlock>
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource TextCaption}">
                                                        <Setter Property="Text" Value="Mulai"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsStopwatchRunning}" Value="True">
                                                                <Setter Property="Text" Value="Jeda"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Button>
                                        <Button Style="{StaticResource FlatButton}" Padding="8,2" Margin="6,0,0,0" Content="Reset" Command="{Binding ResetStopwatchCommand}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- 4. Mode Riwayat Papan Klip (Phase 5) -->
                        <Grid x:Name="PanelClipboard" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,6">
                                <TextBlock Text="Riwayat Papan Klip (Klik teks untuk menyalin)" Style="{StaticResource TextCaption}" VerticalAlignment="Center"/>
                                <Button Content="Bersihkan" Style="{StaticResource FlatButton}" Padding="6,2" HorizontalAlignment="Right" Command="{Binding ClearClipboardCommand}"/>
                            </Grid>

                            <Border Grid.Row="1" Style="{StaticResource FlatCard}" Padding="4">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" Height="85">
                                    <ItemsControl ItemsSource="{Binding ClipboardHistory}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="Transparent"
                                                        BorderBrush="{StaticResource BrushBorder}"
                                                        BorderThickness="0,0,0,1"
                                                        Padding="6,4"
                                                        Cursor="Hand">
                                                    <Border.InputBindings>
                                                        <MouseBinding MouseAction="LeftClick"
                                                                      Command="{Binding DataContext.CopyClipboardItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                      CommandParameter="{Binding}"/>
                                                    </Border.InputBindings>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding PreviewText}" Style="{StaticResource TextBody}" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding DisplayTime}" Style="{StaticResource TextCaption}" Margin="6,0,0,0"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>
                        </Grid>

                        <!-- 5. Mode Peluncur Cepat & Kalender (Phase 5) -->
                        <Grid x:Name="PanelLauncher" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Kalender & Tanggal Offline -->
                            <Border Grid.Row="0" Style="{StaticResource StatusBadge}" Margin="0,0,0,8" Padding="8,4">
                                <Grid>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <controls:LucideIcon Kind="Calendar" Size="13" Foreground="{StaticResource BrushAccent}" Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding CalendarFormattedDate}" Style="{StaticResource TextCaption}" Foreground="{StaticResource BrushPrimaryText}" FontWeight="SemiBold"/>
                                    </StackPanel>
                                    <TextBlock Text="Akses Lokal" Style="{StaticResource TextCaption}" Foreground="{StaticResource BrushMutedText}" HorizontalAlignment="Right"/>
                                </Grid>
                            </Border>

                            <!-- Pintasan Aplikasi Cepat -->
                            <ItemsControl Grid.Row="1" ItemsSource="{Binding LauncherApps}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="5"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource FlatButton}"
                                                Padding="4,6"
                                                Margin="2,0"
                                                Command="{Binding DataContext.LaunchAppCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}">
                                            <StackPanel HorizontalAlignment="Center">
                                                <controls:LucideIcon Kind="{Binding IconKind}" Size="16" Foreground="{StaticResource BrushAccent}" HorizontalAlignment="Center"/>
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource TextCaption}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>


                        <!-- 6. Panel Notifikasi Windows (Phase 6) -->
                        <Grid x:Name="PanelNotif" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Header: Status Izin & Tombol Hapus Semua -->
                            <Grid Grid.Row="0" Margin="0,0,0,6">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <controls:LucideIcon Kind="Bell" Size="12" Foreground="{StaticResource BrushDanger}" Margin="0,0,5,0"/>
                                    <TextBlock Text="{Binding NotificationAccessText}"
                                               Style="{StaticResource TextCaption}"
                                               Foreground="{StaticResource BrushMutedText}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <Button Content="Hapus Semua"
                                        Style="{StaticResource FlatButton}"
                                        Padding="6,2"
                                        HorizontalAlignment="Right"
                                        Command="{Binding ClearAllNotificationsCommand}"/>
                            </Grid>

                            <!-- Daftar Notifikasi -->
                            <Border Grid.Row="1" Style="{StaticResource FlatCard}" Padding="4">
                                <Grid>
                                    <!-- Pesan kosong saat tidak ada notifikasi -->
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,8">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Notifications.Count}" Value="0">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <controls:LucideIcon Kind="Bell" Size="22" Foreground="{StaticResource BrushBorder}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Tidak ada notifikasi"
                                                   Style="{StaticResource TextCaption}"
                                                   Foreground="{StaticResource BrushMutedText}"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,6,0,0"/>
                                    </StackPanel>

                                    <!-- Daftar notifikasi aktif -->
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" Height="85">
                                        <ItemsControl ItemsSource="{Binding Notifications}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="Transparent"
                                                            BorderBrush="{StaticResource BrushBorder}"
                                                            BorderThickness="0,0,0,1"
                                                            Padding="6,5">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="Auto"/>
                                                            </Grid.RowDefinitions>

                                                            <!-- Baris atas: Nama App + Waktu + X -->
                                                            <StackPanel Grid.Column="0" Grid.Row="0" Orientation="Horizontal">
                                                                <TextBlock Text="{Binding AppLabel}"
                                                                           Style="{StaticResource TextCaption}"
                                                                           Foreground="{StaticResource BrushAccent}"
                                                                           FontWeight="SemiBold"/>
                                                                <TextBlock Text=" · "
                                                                           Style="{StaticResource TextCaption}"
                                                                           Foreground="{StaticResource BrushMutedText}"/>
                                                                <TextBlock Text="{Binding DisplayTime}"
                                                                           Style="{StaticResource TextCaption}"
                                                                           Foreground="{StaticResource BrushMutedText}"/>
                                                            </StackPanel>
                                                            <Button Grid.Column="1" Grid.Row="0"
                                                                    Style="{StaticResource IconButton}"
                                                                    Width="18" Height="18"
                                                                    Command="{Binding DataContext.DismissNotificationCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}">
                                                                <controls:LucideIcon Kind="Close" Size="10"/>
                                                            </Button>

                                                            <!-- Baris bawah: Judul + Body -->
                                                            <StackPanel Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="1" Margin="0,2,0,0">
                                                                <TextBlock Text="{Binding Title}"
                                                                           Style="{StaticResource TextBody}"
                                                                           FontWeight="SemiBold"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Text="{Binding BodyPreview}"
                                                                           Style="{StaticResource TextCaption}"
                                                                           Foreground="{StaticResource BrushSecondaryText}"
                                                                           TextWrapping="Wrap"
                                                                           MaxHeight="32"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                        </Grid>

                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>

</Window>
